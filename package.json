{
  "name": "stockai",
  "private": true,
  "version": "0.17.2",
  "type": "module",
  "scripts": {
    "sidecar:build": "mkdir -p src-tauri/bin && OUTFILE=src-tauri/bin/stockai-backend-aarch64-apple-darwin bun sidecar/build-script.ts",
    "dev": "bun run sidecar:build && vite",
    "build": "bun run sidecar:build && tsc && vite build",
    "build:frontend": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:ui": "vitest",
    "test": "bun scripts/test-all.ts",
    "test:integration": "bun scripts/test-all.ts --integration",
    "test:integration:only": "bun scripts/test-all.ts --integration-only",
    "test:e2e": "bun scripts/e2e-smoke.ts",
    "bump-version": "bun scripts/bump-version.ts",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "~2.5.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-store": "~2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "chromium-bidi": "15.0.0",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.61.0",
    "node-html-markdown": "^2.0.0",
    "ollama": "^0.6.4",
    "openai": "^7.39.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "zod": "^4.6.7"
  },
  "patchedDependencies": {
    "chromium-bidi@15.0.0": "patches/chromium-bidi@15.0.0.patch"
  }
}
