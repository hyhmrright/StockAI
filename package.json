    "@types/bun": "^1.3.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.27",
    "chromium-bidi": "^15.0.0",
    "electron": "^41.3.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.8.9",
    "lefthook": "^2.1.5",
    "postcss": "^8.5.8",
