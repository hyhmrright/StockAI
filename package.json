{
  "name": "stockai",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "scripts": {
    "sidecar:build": "mkdir -p src-tauri/bin && OUTFILE=src-tauri/bin/stockai-backend-aarch64-apple-darwin bun sidecar/build-script.ts",
    "dev": "bun run sidecar:build && vite",
    "build": "bun run sidecar:build && tsc && vite build",
    "build:frontend": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:ui": "vitest",
    "test": "bun scripts/test-all.ts",
    "test:integration": "bun scripts/test-all.ts --integration",
    "bump-version": "bun scripts/bump-version.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "~2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "~2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "lightweight-charts": "^4",
    "lucide-react": "^1.7.0",
    "node-html-markdown": "^2.0.0",
    "ollama": "^0.6.3",
    "openai": "^6.33.0",
    "playwright-core": "^1.59.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
